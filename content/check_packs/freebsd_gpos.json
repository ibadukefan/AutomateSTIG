{
  "stig_id": "General_Purpose_Operating_System",
  "platform": "bsd",
  "version": "V3R3",
  "checks": [
    {
      "vuln_id": "V-203615",
      "platform": "bsd",
      "check": { "type": "command", "command": "service auditd onestatus" },
      "expected": {
        "type": "matches",
        "pattern": "(?i)\\A\\s*auditd\\s+is\\s+running(?:\\s+as\\s+pid\\s+[1-9]\\d*)?\\.?\\s*\\z"
      },
      "description": "auditd must be observed in the running state"
    },
    {
      "vuln_id": "V-203714",
      "platform": "bsd",
      "check": { "type": "command", "command": "cat /var/db/zoneinfo" },
      "expected": {
        "type": "matches",
        "pattern": "(?i)\\A\\s*(?:Etc/)?(?:UTC|GMT)\\s*\\z"
      },
      "description": "The configured system time zone must be exactly UTC or GMT"
    },
    {
      "vuln_id": "V-203754",
      "platform": "bsd",
      "check": { "type": "command", "command": "sysctl kern.elf64.aslr.enable" },
      "expected": {
        "type": "matches",
        "pattern": "\\A\\s*kern\\.elf64\\.aslr\\.enable:\\s*1\\s*\\z"
      },
      "description": "The effective 64-bit ASLR kernel setting must be enabled"
    }
  ]
}
