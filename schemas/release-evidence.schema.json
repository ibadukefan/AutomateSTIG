{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://automatestig.example/schemas/release-evidence.schema.json",
  "title": "AutomateSTIG release approval evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "tag",
    "approved_commit",
    "approved_at",
    "pull_request",
    "reviewers",
    "acceptance",
    "recovery_drill",
    "content_signing_key",
    "risk_acceptances"
  ],
  "properties": {
    "schema": { "const": "automatestig-release-evidence/v1" },
    "tag": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
    "approved_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "approved_at": { "type": "string", "format": "date-time" },
    "pull_request": { "type": "integer", "minimum": 1 },
    "reviewers": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "github_login", "approved_at"],
        "properties": {
          "role": { "enum": ["software", "security"] },
          "github_login": { "type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$" },
          "approved_at": { "type": "string", "format": "date-time" },
          "display_name": { "type": "string", "minLength": 1 }
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ontap", "freebsd", "cisco_ios_xe", "stig_viewer", "stig_manager"],
      "properties": {
        "ontap": { "$ref": "#/$defs/gate" },
        "freebsd": { "$ref": "#/$defs/gate" },
        "cisco_ios_xe": { "$ref": "#/$defs/gate" },
        "stig_viewer": { "$ref": "#/$defs/gate" },
        "stig_manager": { "$ref": "#/$defs/gate" }
      }
    },
    "recovery_drill": { "$ref": "#/$defs/gate" },
    "content_signing_key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fingerprint_sha256",
        "ceremony_reference",
        "ceremony_sha256",
        "public_key_reference",
        "public_key_sha256",
        "test_pack_reference",
        "test_pack_sha256"
      ],
      "properties": {
        "fingerprint_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "ceremony_reference": {
          "type": "string",
          "pattern": "^release-evidence/artifacts/[^/]+/content-signing-ceremony\\.json$"
        },
        "ceremony_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "public_key_reference": {
          "type": "string",
          "pattern": "^release-evidence/artifacts/[^/]+/content-signing-public-key\\.pub$"
        },
        "public_key_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "test_pack_reference": {
          "type": "string",
          "pattern": "^release-evidence/artifacts/[^/]+/content-signing-test-pack\\.stigpack$"
        },
        "test_pack_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "risk_acceptances": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "owner", "expires_at", "justification"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "expires_at": { "type": "string", "format": "date-time" },
          "justification": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "executed_at", "environment", "version", "evidence_reference", "evidence_sha256"],
      "properties": {
        "status": { "const": "passed" },
        "executed_at": { "type": "string", "format": "date-time" },
        "environment": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "evidence_reference": {
          "type": "string",
          "pattern": "^release-evidence/artifacts/[^/]+/[^/]+$"
        },
        "evidence_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
