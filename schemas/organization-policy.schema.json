{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://automatestig.dev/schemas/organization-policy.schema.json",
  "title": "AutomateSTIG signed organization policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "policy_id",
    "policy_version",
    "stig_id",
    "stig_release",
    "asset_hostname",
    "effective_from",
    "expires_at",
    "rules"
  ],
  "properties": {
    "schema": {
      "const": "automatestig-organization-policy/v1"
    },
    "policy_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "policy_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "stig_id": {
      "const": "Cisco_IOS-XE_Router_NDM_STIG"
    },
    "stig_release": {
      "const": "V3R7"
    },
    "asset_hostname": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "effective_from": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["V-215807", "V-215836"],
      "properties": {
        "V-215807": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_concurrent_management_sessions"],
          "properties": {
            "max_concurrent_management_sessions": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "V-215836": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum_logging_buffer_bytes"],
          "properties": {
            "minimum_logging_buffer_bytes": {
              "type": "integer",
              "minimum": 4096,
              "maximum": 2147483647
            }
          }
        }
      }
    }
  }
}
